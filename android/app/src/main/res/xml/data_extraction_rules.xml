<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules): chặn cả sao lưu đám mây lẫn chuyển máy trực tiếp.
     Di chuyển dữ liệu giữa các máy sau này đi qua cơ chế khôi phục có xác thực của chính
     app (Personal Pro), không dùng Android Auto Backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
